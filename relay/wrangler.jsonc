{
  "name": "actionhub-relay",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-01",
  "routes": [
    { "pattern": "actionhub.app/*", "zone_name": "actionhub.app" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "RELAY_HUB", "class_name": "RelayHub" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RelayHub"] }
  ],
  "observability": { "enabled": true }
}
